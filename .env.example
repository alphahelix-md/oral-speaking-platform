APP_REGION=global
DEPLOYMENT_STAGE=production
TEXT_PROVIDER=deepseek
TEXT_PROVIDER_ALLOWLIST=openai,deepseek,glm
RATE_LIMIT_PROVIDER=upstash
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
SPEECH_PROVIDER=glm
GLM_TRANSCRIBE_MODEL=glm-asr-2512
# Set true only for temporary mobile diagnosis; production default is off.
NEXT_PUBLIC_SPEECH_DEBUG=false
DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
GLM_API_KEY=
GLM_TEXT_MODEL=glm-4.7-flash
# Required for public beta deployments. Never expose these values to browser code.
BETA_ACCESS_CODES=
BETA_DAILY_REQUEST_LIMIT=20
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
# Preferred: Supabase Dashboard -> Project Settings -> API -> Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is supported if publishable keys are unavailable in the project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enforced Upstash budgets: mandatory outside explicit access-code-only test mode.
# BETA_DAILY_REQUEST_LIMIT now counts provider attempts, including each STT chunk/retry.
# Account/global windows reset at UTC midnight; session/operation keys retain 7 days.
BUDGET_GLOBAL_REQUEST_LIMIT=
BUDGET_SESSION_REQUEST_LIMIT=
BUDGET_ACCOUNT_AUDIO_SECONDS=
BUDGET_GLOBAL_AUDIO_SECONDS=
BUDGET_SESSION_AUDIO_SECONDS=
# Conservative estimated reserves, NOT actual invoices. 1 USD = 1,000,000 micro-USD.
# Set using your verified pricing and maximum request size; no default prices supplied.
BUDGET_ACCOUNT_MICRO_USD=
BUDGET_GLOBAL_MICRO_USD=
BUDGET_SESSION_MICRO_USD=
BUDGET_STT_ATTEMPT_MICRO_USD=
BUDGET_EVALUATION_ATTEMPT_MICRO_USD=
